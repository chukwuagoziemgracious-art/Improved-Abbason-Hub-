rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Health Check Document
    match /test/connection {
      allow get: if true;
    }

    // --- Primitive Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super Admin for Abbason Hub - verified by trusted email from auth token
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'chukwuagoziemgracious@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Helpers ---
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 64 &&
             data.condition in ['new', 'used_like_new', 'used_good'] &&
             data.status in ['pending_review', 'approved', 'rejected'];
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 32 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['delivery_fee_paid', 'in_transit', 'delivered_pending_inspection', 'partially_paid', 'paid_completed', 'paid_awaiting_delivery', 'delivered', 'disputed', 'cancelled'] &&
             data.paymentStatus in ['delivery_fee_paid', 'pending_inspection_pay', 'partially_paid', 'paid_completed', 'escrow_held', 'payout_released', 'refunded'];
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['student', 'seller', 'admin'];
    }

    function isValidReview(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000;
    }

    function isValidComplaint(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderId is string && data.orderId.size() <= 128 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.reason is string && data.reason.size() <= 120 &&
             data.status in ['open', 'resolved_refund', 'resolved_payout'];
    }

    function isValidVerification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.matricNumber is string && data.matricNumber.size() <= 64 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    // --- Collection Security Rules ---

    // 1. Marketplace Products (Public catalog browsing with ownership checks on mutations)
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isSignedIn() &&
        isValidProduct(incoming()) &&
        (incoming().sellerId == request.auth.uid || isAdmin());
      allow update: if isValidId(productId) && (
        isAdmin() ||
        (isSignedIn() && existing().sellerId == request.auth.uid && incoming().sellerId == existing().sellerId && isValidProduct(incoming())) ||
        // Stock decrement during order placement
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) && request.resource.data.stock is number && request.resource.data.stock >= 0)
      );
      allow delete: if isValidId(productId) && (isAdmin() || (isSignedIn() && existing().sellerId == request.auth.uid));
    }

    // 2. Escrow Orders (Strict ABAC: restricted strictly to buyer, seller, or super admin)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid))
      );
      allow list: if isAdmin() ||
        (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow create: if isValidId(orderId) && isSignedIn() &&
        isValidOrder(incoming()) &&
        (incoming().buyerId == request.auth.uid || isAdmin());
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // 3. User Profiles (PII Protection)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow delete: if isAdmin();
    }

    // 4. Seller Reviews (Campus feedback)
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId) && isSignedIn() &&
        isValidReview(incoming()) &&
        incoming().buyerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().buyerId == request.auth.uid);
    }

    // 5. Escrow Complaints & Disputes (Restricted to involved parties and admin)
    match /complaints/{complaintId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow create: if isValidId(complaintId) && isSignedIn() &&
        isValidComplaint(incoming()) &&
        incoming().buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 6. Student Seller Verifications (Strictly private PII: applicant and admin only)
    match /verifications/{verificationId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(verificationId) && isSignedIn() &&
        isValidVerification(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Payout Records (Restricted to vendor and admin)
    match /payouts/{payoutId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
